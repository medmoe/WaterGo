# Enable development behavior for commands that import the app directly
FASTAPI_ENV=development

PROJECT_NAME="Batna Water Delivery"

SECRET_KEY=changethis

# Bootstrap admin account (seeded by init_db); E.164 phone, OTP-only login
FIRST_SUPERUSER_PHONE=+213555000000

# Postgres
POSTGRES_PASSWORD=changethis
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5432/app
POSTGIS_ENABLED=true

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# Auth
OTP_EXPIRY_SECONDS=300

# SMS / WhatsApp provider - reserved for the eventual Infobip / WhatsApp upgrade
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_BASE_URL=

# Interim SMS: SIM-based Android SMS gateway (customer-facing). Real values go
# in .env.local (git-ignored), not here.
SMS_GATEWAY_BASE_URL=
SMS_GATEWAY_API_KEY=
SMS_GATEWAY_DEVICE_ID=

# Telegram bot for the internal team. Put the real bot token in .env.local.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Route clustering (spec section 12, not wired up yet)
ROUTE_CLUSTER_DISTANCE_METERS=1500
