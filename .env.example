# Copy this to `.env` and fill in real values:  cp .env.example .env
# `.env` is git-ignored. Docker Compose reads THIS file's sibling `.env` for
# ${VAR} interpolation in the compose files, and the backend/worker also load
# `.env.local` on top (for secrets you want in a separate file).

# ----------------------------------------------------------------------------
# Local development: keep FASTAPI_ENV=development (relaxes the "changethis"
# secret check). PRODUCTION: delete this line - the app then refuses to start
# with placeholder secrets.
# ----------------------------------------------------------------------------
FASTAPI_ENV=development

PROJECT_NAME="Batna Water Delivery"

# openssl rand -hex 32
SECRET_KEY=changethis

# Bootstrap admin account (seeded by prestart/init_db); E.164 phone, OTP-only.
FIRST_SUPERUSER_PHONE=+213555000000

# --- Postgres --------------------------------------------------------------
# openssl rand -hex 32
POSTGRES_PASSWORD=changethis
# LOCAL (host): localhost:5432.  IN DOCKER: compose overrides host to `db`.
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5432/app
POSTGIS_ENABLED=true

# --- Redis / Celery ------------------------------------------------------
# LOCAL (host): localhost.  IN DOCKER: compose hardcodes redis://redis:6379/0.
REDIS_URL=redis://localhost:6379/0

# --- Auth --------------------------------------------------------------
OTP_EXPIRY_SECONDS=300

# Public URL of the app - used for CORS and the review links sent to customers.
# LOCAL: the Vite dev server. PRODUCTION: https://sarbili.store
FRONTEND_HOST=http://localhost:5173

# --- Production only (leave commented for local dev) ---------------------
# compose.deploy.yml needs DOMAIN + ACME_EMAIL for Traefik + Let's Encrypt.
# DOMAIN=sarbili.store
# ACME_EMAIL=you@example.com

# --- SMS / WhatsApp (future Infobip / WhatsApp upgrade) -------------------
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_BASE_URL=

# --- Interim SMS: SIM-based Android SMS gateway (see docs/interim-messaging) -
# Leave blank to run without SMS (guest checkout + phone-call confirmation
# still work). Fill in to switch the SMS channel on - no redeploy of anything
# else needed.
SMS_GATEWAY_BASE_URL=
SMS_GATEWAY_API_KEY=
SMS_GATEWAY_DEVICE_ID=

# --- Telegram bot (internal team) ---------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- Misc --------------------------------------------------------------
ROUTE_CLUSTER_DISTANCE_METERS=1500
SENTRY_DSN=
